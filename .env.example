PR_HARNESS_HOST=127.0.0.1
PR_HARNESS_PORT=18080
PR_HARNESS_DB_PATH=pr_harness.db
PR_HARNESS_MAX_DIFF_BYTES=1048576
PR_HARNESS_MAX_STEPS=8
PR_HARNESS_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
PR_HARNESS_AUTH_REQUIRED=false
PR_HARNESS_AUTH_SECRET=
PR_HARNESS_BOOTSTRAP_ADMIN_USERNAME=
PR_HARNESS_BOOTSTRAP_ADMIN_PASSWORD=
PR_HARNESS_DEFAULT_TENANT_ID=default
PR_HARNESS_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# API reviews use agentic mode and require a configured model.
# local allows startup/health checks without a key; rule reviewers are internal tools.
PR_HARNESS_LLM_PROVIDER=deepseek

PR_HARNESS_ENABLED_AGENTS=lead,security,correctness-reliability,critic
PR_HARNESS_AGENT_TOKEN_BUDGET=8000
PR_HARNESS_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
PR_HARNESS_AGENT_CONTEXT_WINDOW_TOKENS=32768
PR_HARNESS_AGENT_CONTEXT_INPUT_TOKENS=20000
PR_HARNESS_CONTEXT_DIFF_TOKEN_BUDGET=12000
PR_HARNESS_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
PR_HARNESS_CONTEXT_RECENT_OBSERVATIONS=2
PR_HARNESS_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
PR_HARNESS_LLM_INPUT_COST_PER_MILLION=0
PR_HARNESS_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
PR_HARNESS_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
PR_HARNESS_OPENROUTER_API_KEY=
PR_HARNESS_OPENROUTER_SITE_URL=
PR_HARNESS_OPENROUTER_APP_NAME=PR Harness

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
PR_HARNESS_LLM_BASE_URL=
PR_HARNESS_LLM_API_KEY=
PR_HARNESS_LLM_MODEL=

# Replay evaluation and evolution activation gate
PR_HARNESS_EVAL_MAX_CASES=5
PR_HARNESS_EVAL_MIN_CASES=3
PR_HARNESS_EVAL_MIN_HOLDOUT_CASES=2
PR_HARNESS_EVAL_MIN_IMPROVEMENT=0.01
PR_HARNESS_EVAL_MAX_METRIC_REGRESSION=0
PR_HARNESS_EVALUATION_MIN_PUBLIC_PRS=300
PR_HARNESS_EVALUATION_MIN_F1_IMPROVEMENT=0.03
PR_HARNESS_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
PR_HARNESS_GITHUB_WEBHOOK_SECRET=
PR_HARNESS_GITHUB_TOKEN=
PR_HARNESS_AUTO_POST_REVIEW=false
PR_HARNESS_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
PR_HARNESS_DATABASE_URL=
PR_HARNESS_REDIS_URL=
PR_HARNESS_ASYNC_WORKERS=2
PR_HARNESS_QUEUE_MAX_ATTEMPTS=3
PR_HARNESS_QUEUE_LEASE_SECONDS=60
PR_HARNESS_SKILLS_DIR=skills

# Repair verification and observability
PR_HARNESS_REPAIR_TEST_COMMAND=
PR_HARNESS_REPAIR_VERIFY_TIMEOUT_SECONDS=120
PR_HARNESS_MEMORY_ENABLED=true
PR_HARNESS_MEMORY_RECALL_LIMIT=6
PR_HARNESS_MEMORY_WORKING_TTL_SECONDS=86400
PR_HARNESS_OTEL_ENDPOINT=
PR_HARNESS_OTEL_SERVICE_NAME=pr_harness
PR_HARNESS_ALERT_FAILURE_RATE=0.20
PR_HARNESS_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
PR_HARNESS_GITHUB_APP_ID=
PR_HARNESS_GITHUB_APP_SLUG=
PR_HARNESS_GITHUB_PRIVATE_KEY_PATH=
PR_HARNESS_PUBLIC_BASE_URL=http://127.0.0.1:18080
