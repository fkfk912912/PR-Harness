{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PR Harness",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/Start-PRHarness.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    },
    {
      "name": "PR Harness: Stop",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/Start-PRHarness.ps1",
      "args": [
        "-Stop"
      ],
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true
    }
  ]
}
