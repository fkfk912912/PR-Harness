{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PR Harness",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_github_webhook.py",
      "args": ["--restart"],
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "pythonArgs": ["-B"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "justMyCode": true,
      "subProcess": false,
      "postDebugTask": "PR Harness: Stop automatic review"
    }
  ]
}
